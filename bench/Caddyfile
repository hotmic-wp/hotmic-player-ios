# Linux: BENCH_ROOT=/srv/hotmic BENCH_HOST=bench.example.com caddy run --config bench/Caddyfile
# Use a DNS name with a trusted certificate for HTTPS/HTTP2. For a LAN-only HTTP
# origin: BENCH_HOST=:8088 (HTTP/1.1; TLS is required for HTTP/2 on iOS).
{$BENCH_HOST:localhost} {
    root * {$BENCH_ROOT:./bench/generated}
    file_server
    @media path *.mp4 *.m4s *.jpg
    header @media Cache-Control "public, max-age=3600, immutable"
    @playlist path *.m3u8 *.json
    header @playlist Cache-Control "public, max-age=30"
    log {
        output file {$BENCH_LOG:./bench/results/caddy.jsonl}
        format json
    }
}
